<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Blog") }}</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/index.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Jacquard+24&display=swap" rel="stylesheet">
</head>

<body>
  <header>
  </header>

  <main class="content">


    <div class="container">
      <div class="card">
        <button onclick="history.back()">Return to Whence You Came</button>
        <ul>
	  {% for post in collections.blogposts %}
	    <li>
	      <a href="{{ post.url }}">{{ post.data.title }}</a> 
	      <span> - {{ post.date | dateToRfc822 }}</span>
	    </li>
	  {% endfor %}
        </ul></div>

      <div class="card">
	<h2>{{ date | mdy }}</h2>
        <h1>{{ title }}</h1>
        {{ content | safe }}
      </div>
    </div>
  </main>
</body>


</html>
